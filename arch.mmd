graph TD
    %% Global Styling
    classDef frontend fill:#41B883,stroke:#35495E,stroke-width:2px,color:white;
    classDef backend fill:#4B8BBE,stroke:#306998,stroke-width:2px,color:white;
    classDef database fill:#f2a900,stroke:#333,stroke-width:2px,color:black;
    classDef user fill:#6c5ce7,stroke:#333,stroke-width:2px,color:white;
    classDef concept fill:#f1c40f,stroke:#333,stroke-width:1px,color:black;

    %% -------------------------------------
    %% FRONTEND LAYER (Vercel)
    %% -------------------------------------
    subgraph Frontend ["Frontend Application - Hosted on Vercel"]
        direction TB
        UI["Vue.js 3 UI Layer"]
        
        subgraph Views ["Core Views '/frontend/src/views/'"]
            EmpView("employee/GoalSheet.vue")
            MgrView("manager/TeamDashboard.vue")
            AdmView("admin/AuditLogs.vue")
        end
        
        subgraph State ["State Management '/frontend/src/stores/'"]
            PiniaAuth(("Pinia: AuthStore"))
            PiniaGoal(("Pinia: GoalStore"))
        end
        
        Router{"Vue Router + Guards"}
        Axios[["Axios API Client"]]
        
        UI --> Views
        Views --> Router
        Views --> State
        State --> Axios
    end

    %% -------------------------------------
    %% BACKEND LAYER (Railway)
    %% -------------------------------------
    subgraph Backend ["Backend API - Hosted on Railway Docker Container"]
        direction TB
        AppInit("app/__init__.py")
        
        subgraph Controllers ["Flask Blueprints '/backend/app/routes/'"]
            AuthRoute("auth.py - /register, /login")
            EmpRoute("employee.py - Goals & Check-ins")
            MgrRoute("manager.py - Approvals")
            AdmRoute("admin.py - Cycles & Users")
        end
        
        subgraph Services ["Core Services"]
            JWT>"Flask-JWT-Extended"]
            Cache("Flask-Caching")
            RBAC>"@role_required Decorators"]
            Escalation("Escalation Engine")
        end
        
        SQLA[("SQLAlchemy ORM")]
        
        AppInit --> Controllers
        Controllers --> Services
        Services --> SQLA
    end

    %% -------------------------------------
    %% DATABASE LAYER (SQLite)
    %% -------------------------------------
    subgraph Database ["Database - Persistent Volume '/data/app.db'"]
        direction LR
        subgraph Models ["Entities '/backend/app/models/'"]
            DBUser{"users table"}
            DBGoalSheet{"goal_sheets table"}
            DBGoal{"goals table"}
            DBAch{"achievements table"}
            DBAudit{"audit_logs table"}
        end
    end

    %% -------------------------------------
    %% ACTORS
    %% -------------------------------------
    subgraph Actors ["System Users"]
        Admin(("Admin / HR"))
        Manager(("L1 Manager"))
        Employee(("Employee"))
    end

    %% =====================================
    %% CONNECTIONS & DATA FLOW
    %% =====================================
    Admin -->|"Manages Cycles & Users"| AdmView
    Manager -->|"Approves Goals"| MgrView
    Employee -->|"Logs Achievements"| EmpView
    
    Axios -- "HTTP POST/GET (JSON + Bearer Token)" --> AppInit
    SQLA -- "SQL Queries" --> Models
    
    %% Relationships
    DBUser -->|"1:N"| DBGoalSheet
    DBGoalSheet -->|"1:N"| DBGoal
    DBGoal -->|"1:4"| DBAch
    
    %% Apply Styles
    class UI,Views,State,Router,Axios frontend;
    class AppInit,Controllers,Services,SQLA backend;
    class DBUser,DBGoalSheet,DBGoal,DBAch,DBAudit database;
    class Admin,Manager,Employee user;
    class PiniaAuth,PiniaGoal,JWT,Cache,RBAC,Escalation concept;
